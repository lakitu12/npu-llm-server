@@ -116,10 +116,22 @@ litert::Expected<void> NeuronAdapterApi::LoadSymbols(
   so_paths.push_back(kLibNeuronAdapterLib);
 
   // Add the library from the provided shared lib directory if available.
+  // NOTE (npullm fork): also try the usdk adapter names + absolute system
+  // path (/system_ext/...). App-namespace processes cannot resolve the vendor
+  // bare sonames via the public library list, but an absolute-path dlopen of
+  // a world-readable file can succeed (verified 2026-09-16 via dlprobe).
   if (shared_library_dir.has_value()) {
     so_paths.push_back(
         absl::StrCat(*shared_library_dir, "/", kLibNeuronAdapterLib));
