+                                    "/libneuron_adapter_mgvi.so"));
+    so_paths.push_back(absl::StrCat(*shared_library_dir,
+                                    "/libneuronusdk_adapter.mtk.so"));
+    so_paths.push_back(absl::StrCat(*shared_library_dir,
+                                    "/libneuronusdk_adapter.9.mtk.so"));
   }
+  so_paths.push_back("/system_ext/lib64/libneuronusdk_adapter.mtk.so");
+  so_paths.push_back("/system_ext/lib64/libneuronusdk_adapter.9.mtk.so");
 
 #if !defined(__ANDROID__)
   // Add SDK specific paths for Linux.
